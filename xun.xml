<manifest>
  <remote name="decoder-dev"
          fetch="https://github.com/decoder-dev" />
  <remote name="xun-res"
          fetch="https://github.com/Xiaomi-Redmi-Pad-SE-Resources" />

  <!-- Device, vendor and prebuilt kernel -->
  <project path="device/xiaomi/xun" name="device_xiaomi_xun" remote="decoder-dev" revision="lineage-24.0" />
  <project path="device/xiaomi/xun-kernel" name="android_device_xiaomi_xun-kernel" remote="xun-res" revision="lineage-23.2" clone-depth="1" />
  <project path="vendor/xiaomi/xun" name="android_vendor_xiaomi_xun" remote="xun-res" revision="lineage-23.2" clone-depth="1" />

  <!-- Xiaomi common HALs and sepolicy -->
  <project path="hardware/xiaomi" name="LineageOS/android_hardware_xiaomi" remote="github" revision="lineage-24.0" />

  <!-- Dolby Atmos -->
  <project path="packages/apps/DolbyAtmos" name="roms-experimental/android_packages_apps_DolbyAtmos" remote="github" revision="lineage-24.0" />

  <!-- hardware/qcom-caf/common with bengal on 5.15 mapped to sm6225 -->
  <remove-project name="LineageOS/android_hardware_qcom-caf_common" />
  <project path="hardware/qcom-caf/common" name="hardware_qcom-caf_common" groups="qcom" remote="decoder-dev" revision="lineage-24.0">
    <linkfile src="os_pickup_aosp.mk" dest="hardware/qcom/Android.mk" />
    <linkfile src="os_pickup_sepolicy_vndr.mk" dest="device/qcom/sepolicy_vndr/SEPolicy.mk" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/msm8953/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sdm660/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm6225/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8150/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8250/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8350/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8450/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8450-6.6/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8550/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8650/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8750/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8850/Android.bp" />
  </project>

  <!-- sm6225 (bengal on a 5.15 kernel) HALs -->
  <project path="hardware/qcom-caf/sm6225/audio/agm" name="android_vendor_qcom_opensource_agm" groups="qcom" remote="xun-res" revision="lineage-23.2-caf-sm6225" />
  <project path="hardware/qcom-caf/sm6225/audio/graphservices" name="LineageOS/android_vendor_qcom_opensource_audioreach-graphservices" groups="qcom" remote="github" revision="lineage-24.0-caf-sm8550" />
  <project path="hardware/qcom-caf/sm6225/audio/pal" name="android_vendor_qcom_opensource_arpal-lx" groups="qcom" remote="xun-res" revision="lineage-23.2-caf-sm6225" />
  <project path="hardware/qcom-caf/sm6225/audio/primary-hal" name="android_hardware_qcom_audio-ar" groups="qcom" remote="xun-res" revision="lineage-23.2-caf-sm6225" />
  <project path="hardware/qcom-caf/sm6225/data-ipa-cfg-mgr" name="android_vendor_qcom_opensource_data-ipa-cfg-mgr" groups="qcom" remote="xun-res" revision="lineage-23.2-caf-sm6225" />
  <project path="hardware/qcom-caf/sm6225/dataipa" name="LineageOS/android_vendor_qcom_opensource_dataipa" groups="qcom" remote="github" revision="lineage-24.0-caf-sm8550" />
  <project path="hardware/qcom-caf/sm6225/display" name="hardware_qcom_display" groups="qcom" remote="xun-res" revision="lineage-23.2-caf-sm6225" />
</manifest>
